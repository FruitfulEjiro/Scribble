<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap');

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background-color: #f0f2f5;
        font-family: 'Inter', Arial, sans-serif;
        color: #1a1a2e;
        -webkit-font-smoothing: antialiased;
      }

      .wrapper {
        max-width: 560px;
        margin: 48px auto;
        background: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.07);
      }

      .header {
        background: #1a1a2e;
        padding: 32px 40px;
      }

      .brand-name {
        font-size: 18px;
        font-weight: 600;
        color: #ffffff;
        letter-spacing: -0.3px;
      }

      .body {
        padding: 48px 40px 40px;
      }

      .eyebrow {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #e8724a;
        margin-bottom: 12px;
      }

      h1 {
        font-size: 26px;
        font-weight: 600;
        color: #1a1a2e;
        letter-spacing: -0.5px;
        line-height: 1.3;
        margin-bottom: 16px;
      }

      .desc {
        font-size: 15px;
        color: #5a6375;
        line-height: 1.65;
        margin-bottom: 32px;
      }

      .desc strong {
        color: #1a1a2e;
        font-weight: 600;
      }

      /* Collaborator card */
      .collab-card {
        background: #fff8f6;
        border: 1.5px solid #fcd9cc;
        border-radius: 12px;
        padding: 20px 24px;
        margin-bottom: 32px;
        display: flex;
        align-items: center;
        gap: 16px;
      }

      .avatar {
        width: 44px;
        height: 44px;
        background: #e8724a;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .avatar svg {
        width: 22px;
        height: 22px;
      }

      .collab-info {
        flex: 1;
      }

      .collab-name {
        font-size: 15px;
        font-weight: 600;
        color: #1a1a2e;
        margin-bottom: 4px;
      }

      .collab-meta {
        font-size: 13px;
        color: #5a6375;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .role-badge {
        display: inline-flex;
        align-items: center;
        font-size: 11px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 20px;
        letter-spacing: 0.3px;
      }

      .role-badge.editor {
        background: #eef2ff;
        color: #4f6ef7;
        border: 1px solid #c7d2fe;
      }

      .role-badge.viewer {
        background: #f0fdf4;
        color: #16a34a;
        border: 1px solid #bbf7d0;
      }

      .role-badge.owner {
        background: #fff7ed;
        color: #c2410c;
        border: 1px solid #fed7aa;
      }

      /* Post card */
      .post-card {
        background: #f8f9fb;
        border: 1.5px solid #eceef2;
        border-radius: 12px;
        padding: 20px 24px;
        margin-bottom: 32px;
      }

      .post-card-label {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #8a94a8;
        margin-bottom: 8px;
      }

      .post-card-title {
        font-size: 17px;
        font-weight: 600;
        color: #1a1a2e;
        line-height: 1.4;
      }

      /* CTA */
      .btn-wrap {
        margin-bottom: 32px;
      }

      .btn {
        display: inline-block;
        background: #4f6ef7;
        color: #ffffff;
        text-decoration: none;
        font-size: 15px;
        font-weight: 600;
        padding: 14px 32px;
        border-radius: 10px;
        letter-spacing: -0.2px;
      }

      .divider {
        border: none;
        border-top: 1px solid #eceef2;
        margin-bottom: 28px;
      }

      .info-note {
        background: #f5f7ff;
        border-left: 3px solid #4f6ef7;
        border-radius: 0 8px 8px 0;
        padding: 14px 18px;
        font-size: 13px;
        color: #3a4a7a;
        line-height: 1.55;
        margin-bottom: 32px;
      }

      .info-note strong {
        font-weight: 600;
      }

      .closing {
        font-size: 15px;
        color: #5a6375;
        line-height: 1.65;
      }

      .closing a {
        color: #4f6ef7;
        text-decoration: none;
        font-weight: 500;
      }

      .footer {
        background: #f8f9fb;
        border-top: 1px solid #eceef2;
        padding: 28px 40px;
        text-align: center;
      }

      .footer p {
        font-size: 12px;
        color: #9ba5b4;
        line-height: 1.7;
      }

      .footer a {
        color: #9ba5b4;
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <div class='wrapper'>

      <!-- Header -->
      <div class='header'>
        <span class='brand-name'>Scribble</span>
      </div>

      <!-- Body -->
      <div class='body'>
        <p class='eyebrow'>Invite Declined</p>
        <h1>Your invitation was declined</h1>
        <p class='desc'>
          <strong>{{collaboratorUsername}}</strong>
          has declined your invitation to collaborate on your post. You can
          invite someone else to take their place.
        </p>

        <!-- Collaborator card -->
        <div class='collab-card'>
          <div class='avatar'>
            <svg
              viewBox='0 0 22 22'
              fill='none'
              xmlns='http://www.w3.org/2000/svg'
            >
              <circle cx='11' cy='8' r='4' stroke='white' stroke-width='1.6' />
              <path
                d='M3.5 19c0-4.142 3.358-7 7.5-7s7.5 2.858 7.5 7'
                stroke='white'
                stroke-width='1.6'
                stroke-linecap='round'
              />
            </svg>
          </div>
          <div class='collab-info'>
            <p class='collab-name'>{{collaboratorUsername}}</p>
            <div class='collab-meta'>
              {{collaboratorEmail}}
              &nbsp;·&nbsp;
              <!-- Set class to: editor | viewer | owner -->
              <span class='role-badge {{role}}'>{{role}}</span>
            </div>
          </div>
        </div>

        <!-- Post card -->
        <div class='post-card'>
          <p class='post-card-label'>Post</p>
          <p class='post-card-title'>{{postTitle}}</p>
        </div>

        <!-- CTA -->
        <div class='btn-wrap'>
          <a href='{{postUrl}}' class='btn'>Invite someone else</a>
        </div>

        <hr class='divider' />

        <div class='info-note'>
          <strong>Still need a collaborator?</strong>
          Head to your post and send a new invite to someone else on your team.
        </div>

        <p class='closing'>
          Questions?
          <a href='mailto:support@scribble.com'>Contact support</a>
          and we'll help you out.
        </p>
      </div>

      <!-- Footer -->
      <div class='footer'>
        <p>
          Scribble Inc. · 123 Main Street, Winterfell<br />
          <a href='#'>Unsubscribe</a>
          ·
          <a href='#'>Privacy Policy</a>
        </p>
      </div>

    </div>
  </body>
</html>