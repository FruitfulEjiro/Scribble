<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap');

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background-color: #f0f2f5;
      font-family: 'Inter', Arial, sans-serif;
      color: #1a1a2e;
      -webkit-font-smoothing: antialiased;
    }

    .wrapper {
      max-width: 560px;
      margin: 48px auto;
      background: #ffffff;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 4px 24px rgba(0,0,0,0.07);
    }

    .header {
      background: #1a1a2e;
      padding: 32px 40px;
    }

    .brand-name {
      font-size: 18px;
      font-weight: 600;
      color: #ffffff;
      letter-spacing: -0.3px;
    }

    .body {
      padding: 48px 40px 40px;
    }

    .eyebrow {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: #4f6ef7;
      margin-bottom: 12px;
    }

    h1 {
      font-size: 26px;
      font-weight: 600;
      color: #1a1a2e;
      letter-spacing: -0.5px;
      line-height: 1.3;
      margin-bottom: 16px;
    }

    .desc {
      font-size: 15px;
      color: #5a6375;
      line-height: 1.65;
      margin-bottom: 32px;
    }

    .desc strong {
      color: #1a1a2e;
      font-weight: 600;
    }

    /* Post card */
    .post-card {
      background: #f8f9fb;
      border: 1.5px solid #eceef2;
      border-radius: 12px;
      padding: 20px 24px;
      margin-bottom: 16px;
    }

    .post-card-label {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: #8a94a8;
      margin-bottom: 8px;
    }

    .post-card-title {
      font-size: 17px;
      font-weight: 600;
      color: #1a1a2e;
      line-height: 1.4;
      margin-bottom: 8px;
    }

    .post-card-meta {
      font-size: 13px;
      color: #8a94a8;
    }

    .post-card-meta span {
      color: #4f6ef7;
      font-weight: 500;
    }

    /* Role badge */
    .role-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 32px;
    }

    .role-label {
      font-size: 13px;
      color: #5a6375;
      line-height: 1;
    }

    .role-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      font-size: 12px;
      font-weight: 600;
      padding: 5px 12px;
      border-radius: 20px;
      letter-spacing: 0.3px;
      line-height: 1;
    }

    .role-badge.editor {
      background: #eef2ff;
      color: #4f6ef7;
      border: 1px solid #c7d2fe;
    }

    .role-badge.viewer {
      background: #f0fdf4;
      color: #16a34a;
      border: 1px solid #bbf7d0;
    }

    .role-badge.owner {
      background: #fff7ed;
      color: #c2410c;
      border: 1px solid #fed7aa;
    }

    .role-badge svg {
      width: 11px;
      height: 11px;
      flex-shrink: 0;
      display: block;
    }

    /* CTA */
    .btn-wrap {
      display: flex;
      align-items: center;
      gap: 20px;
      margin-bottom: 32px;
    }

    .btn {
      display: inline-block;
      background: #4f6ef7;
      color: #ffffff;
      text-decoration: none;
      font-size: 15px;
      font-weight: 600;
      padding: 14px 32px;
      border-radius: 10px;
      letter-spacing: -0.2px;
    }

    .decline-link {
      font-size: 14px;
      font-weight: 500;
      color: #8a94a8;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .decline-link:hover {
      color: #e8724a;
    }

    /* Expiry */
    .expiry-notice {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      color: #e8724a;
      font-weight: 500;
      margin-bottom: 32px;
    }

    .expiry-notice svg {
      width: 14px;
      height: 14px;
      flex-shrink: 0;
    }

    .divider {
      border: none;
      border-top: 1px solid #eceef2;
      margin-bottom: 28px;
    }

    .info-note {
      background: #f5f7ff;
      border-left: 3px solid #4f6ef7;
      border-radius: 0 8px 8px 0;
      padding: 14px 18px;
      font-size: 13px;
      color: #3a4a7a;
      line-height: 1.55;
      margin-bottom: 32px;
    }

    .info-note strong {
      font-weight: 600;
    }

    .closing {
      font-size: 15px;
      color: #5a6375;
      line-height: 1.65;
    }

    .closing a {
      color: #4f6ef7;
      text-decoration: none;
      font-weight: 500;
    }

    .footer {
      background: #f8f9fb;
      border-top: 1px solid #eceef2;
      padding: 28px 40px;
      text-align: center;
    }

    .footer p {
      font-size: 12px;
      color: #9ba5b4;
      line-height: 1.7;
    }

    .footer a {
      color: #9ba5b4;
      text-decoration: underline;
    }
  </style>
</head>
<body>
<div class="wrapper">

  <!-- Header -->
  <div class="header">
    <span class="brand-name">Scribble</span>
  </div>

  <!-- Body -->
  <div class="body">
    <p class="eyebrow">Collaboration Invite</p>
    <h1>You've been invited to collaborate</h1>
    <p class="desc">
      <strong>{{authorUsername}}</strong> has invited you to collaborate on a blog post on Scribble. Join them to work on it together.
    </p>

    <!-- Post card -->
    <div class="post-card">
      <p class="post-card-label">Post</p>
      <p class="post-card-title">{{postTitle}}</p>
      <p class="post-card-meta">Invited by <span>{{authorUsername}}</span></p>
    </div>

    <!-- Role badge -->
    <!-- Set the class on .role-badge to: editor | viewer | owner -->
    <div class="role-row">
      <span class="role-label">Your role:</span>
      <span class="role-badge {{role}}">
        <!-- editor icon -->
        <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M8.5 1.5a1.414 1.414 0 0 1 2 2L3.5 10.5l-2.5.5.5-2.5 7-7Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        {{role}}
      </span>
    </div>

    <!-- CTA -->
    <div class="btn-wrap">
      <a href="{{inviteLink}}" class="btn">Accept invitation</a>
      <a href="{{declineLink}}" class="decline-link">Decline</a>
    </div>

    <!-- Expiry -->
    <p class="expiry-notice">
      <svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="7" cy="7" r="6" stroke="#E8724A" stroke-width="1.5"/>
        <path d="M7 4V7.5L9 9" stroke="#E8724A" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      This invitation expires in 7 days
    </p>

    <hr class="divider" />

    <div class="info-note">
      <strong>Not sure about this?</strong> You can decline by ignoring this email. You won't be added to the post unless you explicitly accept.
    </div>

    <p class="closing">
      Questions? <a href="mailto:support@scribble.com">Contact support</a> and we'll help you out.
    </p>
  </div>

  <!-- Footer -->
  <div class="footer">
    <p>
      Scribble Inc. · 123 Main Street, Winterfell<br/>
      <a href="#">Unsubscribe</a> · <a href="#">Privacy Policy</a>
    </p>
  </div>

</div>
</body>
</html>