<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@700&display=swap');

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background-color: #f0f2f5;
        font-family: 'Inter', Arial, sans-serif;
        color: #1a1a2e;
        -webkit-font-smoothing: antialiased;
      }

      .wrapper {
        max-width: 560px;
        margin: 48px auto;
        background: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.07);
      }

      .header {
        background: #1a1a2e;
        padding: 32px 40px;
      }

      .brand-name {
        font-size: 18px;
        font-weight: 600;
        color: #ffffff;
        letter-spacing: -0.3px;
      }

      .body {
        padding: 48px 40px 40px;
      }

      .eyebrow {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #4f6ef7;
        margin-bottom: 12px;
      }

      h1 {
        font-size: 26px;
        font-weight: 600;
        color: #1a1a2e;
        letter-spacing: -0.5px;
        line-height: 1.3;
        margin-bottom: 16px;
      }

      .desc {
        font-size: 15px;
        color: #5a6375;
        line-height: 1.65;
        margin-bottom: 36px;
      }

      .otp-block {
        background: #f5f7ff;
        border: 1.5px solid #dde3ff;
        border-radius: 12px;
        padding: 28px 32px;
        text-align: center;
        margin-bottom: 36px;
      }

      .otp-label {
        font-size: 12px;
        font-weight: 500;
        color: #8a94a8;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        margin-bottom: 12px;
      }

      .otp-code {
        font-family: 'JetBrains Mono', 'Courier New', monospace;
        font-size: 42px;
        font-weight: 700;
        color: #1a1a2e;
        letter-spacing: 10px;
        line-height: 1;
        margin-bottom: 16px;
      }

      .otp-expiry {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        color: #e8724a;
        font-weight: 500;
      }

      .otp-expiry svg {
        width: 14px;
        height: 14px;
      }

      .divider {
        border: none;
        border-top: 1px solid #eceef2;
        margin-bottom: 28px;
      }

      .security-note {
        background: #fffbf5;
        border-left: 3px solid #f5a623;
        border-radius: 0 8px 8px 0;
        padding: 14px 18px;
        font-size: 13px;
        color: #6b5a3e;
        line-height: 1.55;
        margin-bottom: 32px;
      }

      .security-note strong {
        color: #4a3b20;
        font-weight: 600;
      }

      .security-note a {
        color: #4f6ef7;
        text-decoration: none;
        font-weight: 600;
      }

      .closing {
        font-size: 15px;
        color: #5a6375;
        line-height: 1.65;
      }

      .closing a {
        color: #4f6ef7;
        text-decoration: none;
        font-weight: 500;
      }

      .footer {
        background: #f8f9fb;
        border-top: 1px solid #eceef2;
        padding: 28px 40px;
        text-align: center;
      }

      .footer p {
        font-size: 12px;
        color: #9ba5b4;
        line-height: 1.7;
      }

      .footer a {
        color: #9ba5b4;
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <div class='wrapper'>

      <div class='header'>
        <span class='brand-name'>Scribble</span>
      </div>

      <div class='body'>
        <p class='eyebrow'>Password Reset</p>
        <h1>Reset your password</h1>
        <p class='desc'>
          We received a request to reset your Scribble password. Enter the code
          below to proceed. If you didn't request this, you can safely ignore
          this email.
        </p>

        <div class='otp-block'>
          <p class='otp-label'>Reset Code</p>
          <div class='otp-code'>{{code}}</div>
          <span class='otp-expiry'>
            <svg
              viewBox='0 0 14 14'
              fill='none'
              xmlns='http://www.w3.org/2000/svg'
            >
              <circle cx='7' cy='7' r='6' stroke='#E8724A' stroke-width='1.5' />
              <path
                d='M7 4V7.5L9 9'
                stroke='#E8724A'
                stroke-width='1.5'
                stroke-linecap='round'
              />
            </svg>
            Expires in 30 minutes
          </span>
        </div>

        <hr class='divider' />

        <div class='security-note'>
          <strong>Didn't request this?</strong>
          Your password has not been changed. If you're concerned about your
          account's security,
          <a href='mailto:support@scribble.com'>contact support</a>
          immediately.
        </div>

        <p class='closing'>
          Need help?
          <a href='mailto:support@scribble.com'>Contact support</a>
          and we'll get you sorted.
        </p>
      </div>

      <div class='footer'>
        <p>
          Scribble Inc. · 123 Main Street, Winterfell<br />
          <a href='#'>Unsubscribe</a>
          ·
          <a href='#'>Privacy Policy</a>
        </p>
      </div>

    </div>
  </body>
</html>